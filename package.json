{
  "name": "revision-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run questions:build",
    "dev": "vite",
    "build": "npm run questions:build && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "questions:validate": "node scripts/buildQuestionBank.mjs",
    "questions:build": "node scripts/buildQuestionBank.mjs",
    "questions:publish:dry-run": "node scripts/publishQuestionBank.mjs --dry-run",
    "questions:publish": "node scripts/publishQuestionBank.mjs",
    "questions:publish:sync": "node scripts/publishQuestionBank.mjs --prune",
    "questions:verify-remote": "node scripts/verifyPublishedQuestionBank.mjs",
    "functions:prepare": "node scripts/prepareFunctions.mjs",
    "test:core": "node scripts/test-core-flow.mjs && node --test functions/grading.test.js",
    "test:security": "node --test functions/grading.test.js && node scripts/test-security-backend.mjs && node scripts/test-course-mastery.mjs && node scripts/test-spark-grading.mjs && node scripts/test-auth-performance.mjs",
    "deploy:spark": "npm run build && firebase deploy --only firestore:rules,hosting --project revision-hub-ee911"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "katex": "^0.16.47",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4"
  }
}
